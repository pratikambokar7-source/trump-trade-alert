# Copy to .env for local testing (never commit the real .env)
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxx
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxx
NTFY_TOPIC=trump-alerts-pratik

# Optional — access-controlled / private topic (ntfy Pro or self-hosted).
# Leave blank to use the free public ntfy.sh (no auth).
NTFY_SERVER=https://ntfy.sh
NTFY_TOKEN=

# Optional overrides
TIME_WINDOW=120
SOURCES=https://truthsocial.com/@realDonaldTrump
GEMINI_MODEL=gemini-2.5-flash-lite

# Data source fallback chain. Tavily is the only one that reliably bypasses
# Truth Social's Cloudflare protection; direct/proxy fire only if it fails.
# Reorder to try a (working) proxy first, e.g. "proxy,tavily,direct".
FETCH_ORDER=tavily,proxy,direct
PROXY_TEMPLATE=https://api.allorigins.win/raw?url={url}

# Send a "no alerts" heartbeat when nothing is flagged? Default off (quiet).
HEARTBEAT=false
